# Zevo environment template
#
# Quick start:
#   cp .env.example .env
#
# Fill only the Agent driver and GPU provider you plan to use. Leave every
# unrelated credential blank. Never commit the resulting .env file.

# -----------------------------------------------------------------------------
# Agent drivers -- choose at least one
# -----------------------------------------------------------------------------

# 1. Anthropic / Claude Code
#
# Claude subscription: start Zevo, then run
#   docker compose exec scheduler claude auth login
# API usage: set ANTHROPIC_API_KEY instead.
# Example: ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# 2. OpenAI / Codex
#
# ChatGPT subscription: run `codex login` on the host. Zevo imports
# ~/.codex/auth.json automatically, so no API key is required.
# API usage: OPENAI_API_KEY is an optional usage-billed fallback.
# Example: OPENAI_API_KEY=your-openai-api-key
OPENAI_API_KEY=

# 3. Amazon Bedrock
#
# AWS region hosting the selected model.
# Example: AWS_REGION=us-east-1
AWS_REGION=
# Bedrock bearer API key.
# Example: AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
AWS_BEARER_TOKEN_BEDROCK=

# 4. OpenRouter
#
# Example: OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# GPU providers -- choose one
# -----------------------------------------------------------------------------

# Cloud backend selector. Set to `vastai` or `lambda` for a cloud provider.
# Leave blank when using `cluster` or `instance`.
ZEVO_CLOUD_BACKEND=

# 1. Vast.ai
#
# Example:
#   ZEVO_CLOUD_BACKEND=vastai
#   VASTAI_API_KEY=your-vastai-api-key
VASTAI_API_KEY=

# 2. Lambda Cloud
#
# Example:
#   ZEVO_CLOUD_BACKEND=lambda
#   LAMBDA_API_KEY=your-lambda-api-key
LAMBDA_API_KEY=
# Name of an SSH key already registered with Lambda Cloud.
# Example: LAMBDA_SSH_KEY_NAME=zevo-key
LAMBDA_SSH_KEY_NAME=
# Private key path inside the Zevo container. The host ~/.ssh directory is
# mounted at /root/.ssh. Leave blank to probe id_ed25519 and then id_rsa.
# Example: LAMBDA_SSH_KEY_PATH=/root/.ssh/id_ed25519
LAMBDA_SSH_KEY_PATH=

# 3. SSH connections (gpu_provider=cluster or instance)
#
# Every connection has its own tokenized block, so any number of Cluster and
# Instance connections can coexist. Repeat the template with a different
# uppercase token, such as MY_CLUSTER or MY_INSTANCE. A restart imports direct
# .env edits into Settings; UI saves synchronize the same blocks back here.
# Choose SSH_KEY or SSH_PASSWORD_FILE, never both. Host ~/.ssh is mounted
# read-only at /root/.ssh in the containers.
#
# ZEVO_SSH_CONNECTION_MY_CLUSTER_NAME=My cluster
# ZEVO_SSH_CONNECTION_MY_CLUSTER_CATEGORY=cluster
# ZEVO_SSH_CONNECTION_MY_CLUSTER_SSH_HOST=login.example.edu
# ZEVO_SSH_CONNECTION_MY_CLUSTER_SSH_PORT=22
# ZEVO_SSH_CONNECTION_MY_CLUSTER_SSH_USER=my-user
# ZEVO_SSH_CONNECTION_MY_CLUSTER_SSH_KEY=/root/.ssh/id_ed25519
# ZEVO_SSH_CONNECTION_MY_CLUSTER_SSH_PASSWORD_FILE=
# ZEVO_SSH_CONNECTION_MY_CLUSTER_REMOTE_DIR=/scratch/my-user/zevo
# ZEVO_SSH_CONNECTION_MY_CLUSTER_ENV_SETUP=source /opt/miniconda/bin/activate zevo
# ZEVO_SSH_CONNECTION_MY_CLUSTER_CONTAINER_IMAGE=

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------

# Hugging Face Hub token for gated/private models and datasets.
# Example: HF_TOKEN=your-hugging-face-token
HF_TOKEN=

# Weights & Biases training observability.
# Set all three to publish each Train Ticket to an existing W&B project.
# Make that project Public in W&B if everyone should be able to open its URL.
# The API key is forwarded to the training process but never stored in a Run,
# Ticket, YAML artifact, or result.
# Example: WANDB_ENTITY=my-team
WANDB_ENTITY=
# Example: WANDB_PROJECT=zevo
WANDB_PROJECT=
# Example: WANDB_API_KEY=your-wandb-api-key
WANDB_API_KEY=

# -----------------------------------------------------------------------------
# Optional local port overrides
# -----------------------------------------------------------------------------

# The defaults normally require no changes. Uncomment only to resolve a local
# port conflict or use a custom host port.
# WEB_PORT=5173       # Browser dashboard
# BACKEND_PORT=8001   # REST API and OpenAPI documentation
# POSTGRES_PORT=55432 # Host access to PostgreSQL
